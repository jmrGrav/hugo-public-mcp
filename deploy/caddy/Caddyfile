mcp.arleo.eu {
    encode zstd gzip
    log {
        output stderr
        format console
    }

    reverse_proxy 127.0.0.1:8088 {
        transport http {
            dial_timeout 5s
            read_timeout 1h
            write_timeout 1h
        }
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-For {remote}
    }
}
